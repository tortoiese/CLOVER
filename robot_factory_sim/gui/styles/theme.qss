/* CLOVER 관제 화면. 중립 표면 위에 주 동작과 경고를 구분한다. */

* {
    font-size: 10pt;
    color: #eef2f1;
}

QMainWindow, QDialog {
    background: #151a1e;
}

QWidget#Panel, QFrame#Panel {
    background: #20272b;
    border: 1px solid #343e43;
    border-radius: 4px;
}

QLabel#PanelTitle {
    font-size: 11pt;
    font-weight: 700;
    padding: 2px 4px;
}

QLabel#Muted {
    color: #acb9b8;
}

QLabel#InfoChip {
    background: #293632;
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 9pt;
}

/* ---------------- 툴바 ---------------- */
QToolBar {
    background: #20272b;
    border: none;
    border-bottom: 1px solid #343e43;
    padding: 7px 8px;
    spacing: 5px;
}

QToolBar QToolButton, QPushButton {
    background: #293632;
    border: 1px solid #405650;
    border-radius: 4px;
    padding: 5px 12px;
}

QToolBar QToolButton:hover, QPushButton:hover {
    background: #344943;
    border-color: #73b8a3;
}

QToolBar QToolButton:focus, QPushButton:focus, QToolButton#QuickCommand:focus {
    border-color: #9bccbd;
}

QToolBar::separator {
    background: #39454a;
    width: 1px;
    margin: 4px 3px;
}

QToolBar QToolButton:pressed, QPushButton:pressed {
    background: #22332e;
}

QToolBar QToolButton:checked, QPushButton:checked {
    background: #326455;
    border-color: #9bccbd;
}

QToolBar QToolButton:disabled, QPushButton:disabled {
    color: #7d8a8c;
    background: #20272b;
    border-color: #343e43;
}

QPushButton#Primary:enabled, QToolButton#StartSimulation:enabled {
    background: #326455;
    border-color: #559780;
    color: #ffffff;
    font-weight: 700;
}

QPushButton#Primary:hover:enabled, QToolButton#StartSimulation:hover:enabled {
    background: #3b7563;
    border-color: #9bccbd;
}

QPushButton#Danger {
    background: #7b241c;
    border-color: #e74c3c;
}

QLabel#DbStatus {
    padding: 3px 10px;
    border-radius: 8px;
    background: #293632;
}

QLabel#DbStatus[connected="true"] {
    color: #8bcda3;
}

QLabel#DbStatus[connected="false"] {
    color: #e74c3c;
}

QMenu {
    background: #20272b;
    border: 1px solid #425052;
    padding: 4px;
}

QMenu::item {
    padding: 6px 18px 6px 10px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #293632;
}

QMenu::item:disabled {
    color: #acb9b8;
}

QMenu::separator {
    height: 1px;
    background: #39454a;
    margin: 4px 6px;
}

/* ---------------- 입력 ---------------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit {
    background: #181e22;
    border: 1px solid #39454a;
    border-radius: 6px;
    padding: 4px 6px;
    selection-background-color: #73b8a3;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #73b8a3;
}

QComboBox QAbstractItemView {
    background: #20272b;
    selection-background-color: #293632;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
}

/* ---------------- 스플리터 / 스크롤 ---------------- */
QSplitter::handle {
    background: #151a1e;
}

QSplitter::handle:hover {
    background: #73b8a3;
}

QSplitter#WorkspaceSplitter::handle:horizontal {
    background: #39454a;
    border-left: 3px solid #151a1e;
    border-right: 3px solid #151a1e;
    margin: 8px 0;
}

QSplitter#WorkspaceSplitter::handle:horizontal:hover {
    background: #73b8a3;
}

QWidget#FloorHeader QPushButton {
    padding: 3px 7px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 9px;
}

QScrollBar::handle:vertical {
    background: #39454a;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 9px;
}

QScrollBar::handle:horizontal {
    background: #39454a;
    border-radius: 4px;
    min-width: 24px;
}

QGraphicsView {
    border: none;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
}

/* ---------------- 탭 ---------------- */
QTabWidget::pane {
    border: 1px solid #343e43;
    border-radius: 8px;
    background: #20272b;
    top: -1px;
}

QTabBar::tab {
    background: #151a1e;
    border: 1px solid #343e43;
    padding: 5px 10px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    color: #acb9b8;
}

QTabBar::tab:selected {
    background: #293632;
    color: #eef2f1;
}

QTabBar::tab:hover {
    color: #eef2f1;
}

QTabBar QToolButton {
    background: #20272b;
    border: 1px solid #425052;
}

QTabWidget#WorkspaceTabs > QTabBar::tab {
    padding: 7px 16px;
}

QTabWidget#WorkspaceTabs > QTabBar::tab:selected {
    border-top: 2px solid #73b8a3;
    font-weight: 600;
}

QProgressBar#PeriodProgress {
    background: #181e22;
    border: 1px solid #343e43;
    border-radius: 4px;
    text-align: center;
}

QProgressBar#PeriodProgress::chunk {
    background: #326455;
    border-radius: 3px;
}

QWidget#RoiScrollContent, QWidget#KpiDetailContent {
    background: #20272b;
}

/* ---------------- 표 / 리스트 ---------------- */
QTableWidget, QListWidget, QTreeWidget {
    background: #181e22;
    alternate-background-color: #242e32;
    border: 1px solid #343e43;
    border-radius: 6px;
    gridline-color: #343e43;
}

QHeaderView::section {
    background: #293632;
    border: none;
    padding: 4px;
    font-weight: 700;
}

QListWidget::item {
    padding: 6px;
    border-radius: 5px;
}

QListWidget::item:hover {
    background: #293632;
}

QListWidget::item:selected {
    background: #344943;
}

QGroupBox {
    border: 1px solid #343e43;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    color: #acb9b8;
}

/* ---------------- KPI 카드 ---------------- */
QFrame#KpiCard {
    background: #181e22;
    border: 1px solid #343e43;
    border-radius: 3px;
}

QFrame#KpiCard[featured="true"] {
    background: #252f30;
    border: 1px solid #465552;
    border-top: 2px solid #73b8a3;
}

QFrame#KpiCard[featured="true"] QLabel#KpiValue {
    font-size: 26pt;
}

QLabel#KpiReference {
    color: #acb9b8;
    font-size: 9pt;
}

QToolButton#KpiDetailsToggle {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    color: #ccd6d3;
    padding: 3px 6px;
}

QToolButton#KpiDetailsToggle:hover, QToolButton#KpiDetailsToggle:focus {
    background: #293632;
    border-color: #559780;
}

QLabel#KpiTitle {
    color: #acb9b8;
    font-size: 9pt;
}

QLabel#KpiValue {
    font-size: 16pt;
    font-weight: 700;
}

QLabel#KpiUnit {
    color: #acb9b8;
    font-size: 9pt;
}

QLabel#KpiDelta {
    font-size: 9pt;
    font-weight: 700;
}

QLabel#KpiDelta[trend="better"] {
    color: #8bcda3;
}

QLabel#KpiDelta[trend="worse"] {
    color: #f19788;
}

QLabel#KpiDelta[trend="flat"] {
    color: #acb9b8;
}

/* ---------------- 채팅 ---------------- */
QWidget#ChatArea {
    background: transparent;
}

QFrame#Bubble {
    border-radius: 5px;
    padding: 2px;
}

QFrame#Bubble[role="user"] {
    background: #405650;
    border: 1px solid #73b8a3;
}

QFrame#Bubble[role="agent"] {
    background: #181e22;
    border: 1px solid #39454a;
}

QFrame#Bubble[role="agent"][severity="warning"] {
    border: 1px solid #f39c12;
}

QFrame#Bubble[role="agent"][severity="critical"] {
    border: 2px solid #e74c3c;
    background: #2a1420;
}

QFrame#Bubble[role="system"] {
    background: transparent;
    border: 1px dashed #39454a;
}

QLabel#BubbleText {
    font-size: 10pt;
}

QLabel#BubbleMeta {
    color: #acb9b8;
    font-size: 8pt;
}

QLabel#Badge {
    background: #e74c3c;
    border-radius: 9px;
    padding: 1px 7px;
    font-weight: 700;
    font-size: 9pt;
}

QToolButton#QuickCommand, QPushButton#LatestMessages {
    background: #181e22;
    border: 1px solid #39454a;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 9pt;
}

QToolButton#QuickCommand:hover, QPushButton#LatestMessages:hover {
    border-color: #73b8a3;
}

/* ---------------- 상태 영역 / 긴급 배너 ---------------- */
QWidget#WorkspaceStatus {
    background: #20272b;
    border: 1px solid #343e43;
    border-radius: 8px;
}

QLabel#SimulationStatus {
    font-weight: 600;
    color: #ccd6d3;
}

QFrame#AlertBanner {
    border: 1px solid #e74c3c;
    border-radius: 8px;
}

QFrame#AlertBanner[severity="critical"] {
    background: #4e2431;
}

QFrame#AlertBanner[severity="warning"] {
    background: #4b351f;
    border-color: #f39c12;
}

QLabel#BannerTitle {
    font-size: 11pt;
    font-weight: 800;
    color: #ffffff;
}

QLabel#BannerText {
    color: #ffffff;
}

QPushButton#BannerClose {
    background: transparent;
    border: none;
    font-size: 13pt;
    color: #ffffff;
    padding: 0 6px;
}

QPushButton#BannerView {
    background: #20272b;
    border-color: #657476;
    padding: 4px 10px;
}

QToolTip {
    background: #293632;
    border: 1px solid #73b8a3;
    color: #eef2f1;
    padding: 4px;
}
